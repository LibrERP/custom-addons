<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_milestones_form_view" model="ir.ui.view">
        <field name="name">sale.order.milestones.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="project_milestones" string="Project Milestones">
                    <field name="milestone_ids" widget="sol_o2m">
                        <list string="Milestones" >
                            <field name="name"/>
                            <field name="deadline"/>
                            <field name="is_reached"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>