<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_contract_ids" model="ir.ui.view">
        <field name="name">sale.order.form.contract.ids</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']/group/group[@name='sale_shipping']" position="after">
                <group string="Contracts" name="contract_info">
                    <field name="contract_ids" widget="many2many_tags" readonly="1" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>