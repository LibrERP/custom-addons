<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_download_excel_report" model="ir.actions.server">
        <field name="name">Download report in Excel</field>
        <field name="model_id" ref="model_stock_inventory"/>
        <field name="state">code</field>
        <field name="code">
            if model._context.get('active_model') == 'stock.inventory':
                action = model.download_stock_report()
        </field>
        <field name="binding_model_id" ref="stock.model_stock_inventory" />
    </record>
</odoo>
