<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ateco_category_plus_form" model="ir.ui.view">
        <field name="name">ateco.category.plus.form</field>
        <field name="model">ateco.category</field>
        <field name="inherit_id" ref="l10n_it_ateco.view_ateco_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group/field[@name='code']" position="before">
                <field name="macro_category_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_ateco_category_plus_tree" model="ir.ui.view">
        <field name="name">ateco.category.plus.tree</field>
        <field name="model">ateco.category</field>
        <field name="inherit_id" ref="l10n_it_ateco.view_ateco_category_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="before">
                <field name="macro_category_name"/>
            </xpath>
        </field>
    </record>

    <record id="view_ateco_category_plus_search" model="ir.ui.view">
        <field name="name">ateco.category.plus.search</field>
        <field name="model">ateco.category</field>
        <field name="inherit_id" ref="l10n_it_ateco.ateco_category_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="search_code" string="Code"/>
                <field name="search_name" string="Name"/>
            </xpath>
            <xpath expr="//field[@name='code']" position="replace"/>
        </field>
    </record>
</odoo>
