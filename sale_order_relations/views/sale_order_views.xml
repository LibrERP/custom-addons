<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sale Orders" name="child_orders">
                    <group>
                        <field name="parent_id" domain="[('partner_id', '=', partner_id), ('id', '!=', id)]"/>
                    </group>
                    <field
                        name="child_ids"
                        mode="list"
                        readonly="False"
                        context="{
                            'default_partner_id': partner_id,
                            'default_sale_order_template_id': sale_order_template_id,
                            'default_payment_term_id': payment_term_id,
                            'default_validity_date': validity_date,
                            'deafult_date_order': date_order
                        }"
                    >
                        <list
                            string="Realated Sale Orders"
                        >
                            <field name="name"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
