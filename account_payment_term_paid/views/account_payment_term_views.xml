<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_already_paid" model="ir.ui.view">
        <field name="name">account.payment.term.form.already.paid</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_on_invoice']" position="after">
                <div>
                    <label for="already_paid"/>
                    <field name="already_paid"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
