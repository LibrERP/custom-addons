<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_template_form" model="ir.ui.view">
        <field name="name">sale.order.template.form</field>
        <field name="model">sale.order.template</field>
        <field name="priority">1001</field>
        <field name="arch" type="xml">
            <form>
                <field name="sale_order_template_line_ids">
                    <tree editable="top" delete="false" create="false">
                        <field name="check" nolabel="True"/>
                        <field name="name" readonly="True"/>
                        <field name="product_id" readonly="True"/>
<!--                        <field name="state"/>-->
        <!--                <field name="company_id" invisible="True"/>-->
                    </tree>
                </field>
                <footer>
                    <button name="add_selected_line" string="Add lines" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_sale_order_template_preselect_form" model="ir.ui.view">
        <field name="name">sale.order.template.preselect.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='sale_order_template_line_ids']/tree/field[@name='sequence']" position="before">
                <field name="preselected"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_template" model="ir.ui.view">
        <field name="name">sale.order.form.template</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <button name="select_lines" string="Select Lines" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
