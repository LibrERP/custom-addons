<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_import_moves" model="ir.ui.view">
        <field name="name">stock.picking.import.moves.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_move_import"
                        type="object"
                        string="Import Moves"
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
