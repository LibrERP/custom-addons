<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_l10n_it_supplier_ddt" model="ir.ui.view">
        <field name="name">stock.picking.form.l10n.it.supplier.ddt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <group name="carrier_data" position="after">
                <group string="Supplier DDT" invisible="country_code != 'IT' or picking_type_code != 'incoming'">
                    <field name="l10n_it_supplier_ddt_number"/>
                    <field name="l10n_it_supplier_ddt_date"/>
                </group>
            </group>
        </field>
    </record>

    <record id="view_picking_search_inherit_l10n_it_supplier_ddt" model="ir.ui.view">
        <field name="name">stock.picking.search.l10n.it.supplier.ddt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="l10n_it_supplier_ddt_number"/>
            </field>
        </field>
    </record>

    <record id="view_picking_tree_inherit_l10n_it_supplier_ddt" model="ir.ui.view">
        <field name="name">stock.picking.list.l10n.it.supplier.ddt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="l10n_it_supplier_ddt_number" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>