<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_search" model="ir.ui.view">
        <field name="name">ir.attachment.search.missing.files</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_search"/>
        <field name="arch" type="xml">
            <filter name="binary_filter" position="after">
                <separator/>
                <filter name="missing_files"
                        string="Missing Files"
                        domain="[('id', 'in', 'missing_attachments')]"/>
            </filter>
        </field>
    </record>
</odoo>