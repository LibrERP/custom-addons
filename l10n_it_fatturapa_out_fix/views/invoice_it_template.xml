<odoo>
    <!-- Render <Arrotondamento> in DatiRiepilogo when WizardExportFatturapa.getAllTaxes
         added it (price-included per-line VAT rounding fix). FatturaPA element order
         (2.2.2) requires Arrotondamento to appear right before ImponibileImporto. -->
    <template
        id="fattura_elettronica_body_arrotondamento"
        inherit_id="l10n_it_fatturapa_out.account_invoice_it_fattura_elettronica_body"
    >
        <xpath expr="//DatiRiepilogo/ImponibileImporto" position="before">
            <Arrotondamento
                t-if="tax_data.get('Arrotondamento')"
                t-out="format_monetary(tax_data['Arrotondamento'], euro)"
            />
        </xpath>
    </template>
</odoo>
