<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_holidays_public_form_view" model="ir.ui.view">
        <field name="name">hr.holidays.public.form</field>
        <field name="model">hr.holidays.public</field>
        <field name="inherit_id" ref="hr_holidays_public.view_holidays_public_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_detail']/field[@name='line_ids']/tree/field[@name='variable_date']" position="after">
                <field name="city_id"/>
            </xpath>
        </field>
    </record>
</odoo>
