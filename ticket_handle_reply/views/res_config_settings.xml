<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="settings_ticket_reply_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="helpdesk_mgmt.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='helpdesk_mgmt']" position="inside">
                <h2>On ticket reply</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="reply_stage_id" />
                            <div class="text-muted">Set where to move ticket on reply</div>
                            <field name="reply_stage_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>