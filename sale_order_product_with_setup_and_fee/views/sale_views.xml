<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_setup_and_fee_form_view" model="ir.ui.view">
        <field name="name">sale.order.setup.fee.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="after">
                <field name="line_id" group="base.group_no_one"/>
                <field name="unique_id" group="base.group_no_one"/>
                <field name="change" group="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
