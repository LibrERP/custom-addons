<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_calendar_week_tree" model="ir.ui.view">
            <field name="name">view.calendar.week.tree</field>
            <field name="model">res.calendar.week</field>
            <field name="arch" type="xml">
                <list string="Weeks">
                    <field name="name"/>
                    <field name="week_code"/>
                    <field name="day_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="view_calendar_week_form" model="ir.ui.view">
            <field name="name">view.calendar.week.form</field>
            <field name="model">res.calendar.week</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Week">
                <sheet>
                    <group colspan="4" col="4">
                        <field name="name" placeholder="Week Name"/>
                        <field name="week_code"/>
                    </group>
                    <separator/>
                    <group colspan="4" col="4">
                        <field name="day_ids"/>
                    </group>
                </sheet>
                </form>
           </field>
        </record>

        <record id="view_calendar_week_search" model="ir.ui.view">
            <field name="name">view.calendar.week.search</field>
            <field name="model">res.calendar.week</field>
            <field name="arch" type="xml">
                <search string="Calendar Weeks">
                    <field name="name"/>
                    <field name="week_code"/>
                    <field name="day_ids"/>
                </search>
           </field>
        </record>

        <record id="action_calendar_week_tree" model="ir.actions.act_window">
            <field name="name">Calendar Weeks</field>
            <field name="res_model">res.calendar.week</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,form</field>
       </record>
 
     </data>
</odoo>