<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="morning_reg" model="res.calendar.intervals">
            <field name="name">Morning Regular</field>
            <field name="hour_code">moreg</field>
            <field eval="8" name="start_hour" />
            <field eval="30" name="start_minute" />
            <field eval="12" name="end_hour" />
            <field eval="30" name="end_minute" />
        </record>

        <record id="morning_std" model="res.calendar.intervals">
            <field name="name">Morning Standard</field>
            <field name="hour_code">mostd</field>
            <field eval="9" name="start_hour" />
            <field eval="0" name="start_minute" />
            <field eval="13" name="end_hour" />
            <field eval="0" name="end_minute" />
        </record>

        <record id="afternoon_reg" model="res.calendar.intervals">
            <field name="name">Afternoon Regular</field>
            <field name="hour_code">afreg</field>
            <field eval="13" name="start_hour" />
            <field eval="30" name="start_minute" />
            <field eval="17" name="end_hour" />
            <field eval="30" name="end_minute" />
        </record>

        <record id="afternoon_std" model="res.calendar.intervals">
            <field name="name">Afternoon Standard</field>
            <field name="hour_code">afstd</field>
            <field eval="14" name="start_hour" />
            <field eval="0" name="start_minute" />
            <field eval="18" name="end_hour" />
            <field eval="0" name="end_minute" />
        </record>

        <record id="afternoon_ext" model="res.calendar.intervals">
            <field name="name">Afternoon Extended</field>
            <field name="hour_code">afext</field>
            <field eval="14" name="start_hour" />
            <field eval="30" name="start_minute" />
            <field eval="18" name="end_hour" />
            <field eval="30" name="end_minute" />
        </record>

        <record id="morning_daily" model="res.calendar.intervals">
            <field name="name">Daily Morning</field>
            <field name="hour_code">moday</field>
            <field eval="6" name="start_hour" />
            <field eval="0" name="start_minute" />
            <field eval="14" name="end_hour" />
            <field eval="0" name="end_minute" />
        </record>

        <record id="afternoon_daily" model="res.calendar.intervals">
            <field name="name">Daily Afternoon</field>
            <field name="hour_code">afday</field>
            <field eval="14" name="start_hour" />
            <field eval="0" name="start_minute" />
            <field eval="22" name="end_hour" />
            <field eval="0" name="end_minute" />
        </record>

        <record id="night_daily" model="res.calendar.intervals">
            <field name="name">Daily Night</field>
            <field name="hour_code">niday</field>
            <field eval="22" name="start_hour" />
            <field eval="0" name="start_minute" />
            <field eval="6" name="end_hour" />
            <field eval="0" name="end_minute" />
        </record>


    </data>
</odoo>