<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="monday_reg" model="res.calendar.day">
            <field name="name">Regular Monday</field>
            <field name="code">Monday</field>
            <field name="day_code">mo</field>
            <field eval="0" name="day_number" />
            <field name="interval_ids" 
                eval="[(6,0,[ref('morning_reg'),ref('afternoon_reg')])]"/>
         </record>
