<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_crm_list" model="ir.ui.view">
        <field name="name">sale.order.crm.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="lead_stage_id" optional="hide"/>
                <field name="lead_status" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_crm_search_view" model="ir.ui.view">
        <field name="name">sale.order.crm.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="won" string="Vinta" domain="[('lead_status', '=', 'won')]"/>
                <filter name="lost" string="Persa" domain="[('lead_status', '=', 'lost')]"/>
            </xpath>
        </field>
    </record>
</odoo>
